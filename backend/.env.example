# Example server environment. Copy the names, not this file: the app reads real environment variables
# (set them in your shell locally, or in the host's dashboard). Never commit real values.

# Place search (Geoapify Address Autocomplete). Get a free key at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# Production settings
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-app.example.com

# Optional per-client-IP limits (DRF rate format)
GEOCODE_THROTTLE_RATE=30/minute
API_THROTTLE_RATE=120/hour

# Proxies in front of the app on your host (usually 1), so rate limits see the real client IP
API_NUM_PROXIES=1
